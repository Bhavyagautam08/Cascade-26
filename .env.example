# Copied to backend/.env by scripts\setup_device.ps1 (which also fills in the device-specific lines).

# The device's name in the family: unique per device, 1-32 letters/digits/-/_ (phone-1, phone-2, ...).
# The ledger file remembers it and refuses to open under another name.
DEVICE_ID=phone-1

# Where this device's SQLite event log lives (relative to backend/)
DB_PATH=data/ledger-phone-1.db

# Ollama: the app only talks to its local API. Ollama finds its own models; nothing to configure.
OLLAMA_HOST=http://127.0.0.1:11434

# Models
# real = Whisper + Ollama. demo = same API with stand-ins (scripted ASR, rule parser, sample slip),
# for laptops whose models aren't installed yet. Every demo response is labelled "demo".
MODEL_MODE=real
# Whisper "small" only. It lives in the user's Hugging Face cache (%USERPROFILE%\.cache\huggingface),
# downloaded there once. If CUDA fails, the same model runs on the CPU.
# No NVIDIA GPU: WHISPER_DEVICE=cpu and WHISPER_COMPUTE_TYPE=int8 (setup_device.ps1 does this).
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
LLM_MODEL=qwen3-vl:4b-instruct

# Always-on microphone (only the vendor's main device)
MIC_ENABLED=false
# Mic name as shown in the app (Record a trade > Heard by the mic); empty = the Windows default mic.
MIC_DEVICE=
# The same trade heard again within this many seconds is booked once; less clear than this is held.
VOICE_REPEAT_WINDOW_S=60
VOICE_MIN_CLARITY=0.25

# Family sync. PEERS: the other devices, comma-separated, e.g. http://192.168.1.12:8000,http://192.168.1.13:8000
PEERS=
# Shared secret of the family's devices (same value on every device). Empty = anyone on the Wi-Fi can sync.
SYNC_KEY=
# Sync every this many seconds and right after each new entry; 0 = only when "Sync now" is pressed.
# Keep it short: two phones' entries are timed against shared sync moments (see docs/ARCHITECTURE.md 6.6).
SYNC_INTERVAL_S=5

# Simulate a broken phone clock for the hostile-clock demo: off | 1970 | jump
HOSTILE_CLOCK=off

# UI endpoints answer only this laptop unless true
ALLOW_REMOTE_UI=false
