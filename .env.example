# Copy to backend/.env and adjust per device.

# Identity of this device in the family sync (must be unique per device)
DEVICE_ID=phone-1

# Where the SQLite event log lives
DB_PATH=data/ledger-phone-1.db

# Ollama: the app only talks to its local API. Ollama finds its own models; nothing to configure.
OLLAMA_HOST=http://127.0.0.1:11434

# Models
# real = Whisper + Ollama. demo = same API with stand-ins (scripted ASR, rule parser, sample slip),
# for laptops whose models aren't installed yet. Every demo response is labelled "demo".
MODEL_MODE=real
# Whisper "small" only. It lives in the user's Hugging Face cache (%USERPROFILE%\.cache\huggingface),
# downloaded there once. If CUDA fails, the same model runs on the CPU. WHISPER_DEVICE=cpu on laptops
# without an NVIDIA GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
LLM_MODEL=qwen3-vl:4b-instruct

# Always-on microphone
MIC_ENABLED=false
# Mic name as shown in the app (Record a trade > Heard by the mic); empty = the Windows default mic.
MIC_DEVICE=
# The same trade heard again within this many seconds is booked once; less clear than this is held.
VOICE_REPEAT_WINDOW_S=60
VOICE_MIN_CLARITY=0.25

# Peers for sync over LAN (comma-separated base URLs)
PEERS=

# Simulate a broken phone clock for the hostile-clock demo: off | 1970 | jump
HOSTILE_CLOCK=off

# Shared secret of the family's devices (same value on every phone). Empty = sync is open to anyone on the LAN.
SYNC_KEY=
# UI endpoints answer only this laptop unless true
ALLOW_REMOTE_UI=false
